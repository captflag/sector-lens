# ---------------------------------------------------------------------------
# Sector Lens - environment configuration
# Copy to `.env` and fill in. Never commit a real key.
# ---------------------------------------------------------------------------

# LLM provider: "anthropic" (real answers) or "deterministic" (no key required).
# The deterministic provider still queries the database over MCP and produces a
# real, data-grounded answer -- it just composes it from persona templates
# instead of an LLM. Use it to run and evaluate the system without API credentials.
SECTORLENS_LLM_PROVIDER=anthropic

# Required when SECTORLENS_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Model + effort. See README "LLM choice".
SECTORLENS_MODEL=claude-opus-5
SECTORLENS_EFFORT=medium
SECTORLENS_MAX_TOKENS=16000

# Max agentic tool-calling rounds before the agent must answer.
SECTORLENS_MAX_TOOL_ROUNDS=6

# Path to the SQLite database the MCP server reads.
SECTORLENS_DB_PATH=data/sector_intel.db

# Contact string sent as the User-Agent when ingesting from SEC EDGAR.
# SEC requires a real contact address; requests without one are throttled/blocked.
SECTORLENS_SEC_USER_AGENT=Your Name your.email@example.com

# Base URL used by the Streamlit UI when it is set to call the REST API
# instead of the in-process agent.
SECTORLENS_API_BASE_URL=http://127.0.0.1:8000
